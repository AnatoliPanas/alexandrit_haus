---
const bookingUrl = "https://alexandrithaus.sviigo.site";

const navigation = [
  { label: "Behandlungen", href: "#treatments" },
  { label: "Vorbereitung & Nachsorge", href: "#preparation" },
  { label: "Ablauf", href: "#procedure" },
  { label: "FAQ", href: "#faq" },
  { label: "Bewertungen", href: "#bewertungen" },
];

const contact = {
  address: "Adresse wird ergänzt",
  phone: "",
  email: "",
  instagram: "",
  whatsapp: "",
  tiktok: "",
};

const socials = [
  {
    name: "Instagram",
    url: contact.instagram,
    icon: "instagram",
  },
  {
    name: "WhatsApp",
    url: contact.whatsapp,
    icon: "whatsapp",
  },
  {
    name: "TikTok",
    url: contact.tiktok,
    icon: "tiktok",
  },
];

const openingHours = [
  { day: "Montag – Freitag", hours: "Nach Vereinbarung" },
  { day: "Samstag", hours: "Nach Vereinbarung" },
  { day: "Sonntag", hours: "Geschlossen" },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer" id="footer">
  <div class="footer-inner">
    <div class="footer-main">
      <!-- LOGO / BRAND -->

      <div class="footer-brand">
        <div class="footer-brand-top">
          <a href="/" class="footer-logo">
            Alexandrit<span>Haus</span>
          </a>

          <!-- MOBILE SOCIALS -->

          <div class="footer-socials">
            {socials.map((social) => {
              const Tag = social.url ? "a" : "span";

              return (
                <Tag
                  href={social.url || undefined}
                  target={social.url ? "_blank" : undefined}
                  rel={social.url ? "noopener noreferrer" : undefined}
                  class:list={[
                    "footer-social-link",
                    { "social-disabled": !social.url },
                  ]}
                  aria-label={social.name}
                  title={
                    social.url ? social.name : `${social.name} – Link folgt`
                  }
                >
                  {social.icon === "instagram" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect
                        x="3"
                        y="3"
                        width="18"
                        height="18"
                        rx="5"
                        stroke="currentColor"
                        stroke-width="1.6"
                      />
                      <circle
                        cx="12"
                        cy="12"
                        r="4"
                        stroke="currentColor"
                        stroke-width="1.6"
                      />
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
                    </svg>
                  )}

                  {social.icon === "whatsapp" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                      />
                      <path
                        d="M9 8.5c.5 3 2.5 5 5.5 6l1.5-1.5 2 1c-.5 2-2 3-4 2-3-1-6-4-7-7-.5-2 .5-3.5 2-4l1 2-1 1.5Z"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}

                  {social.icon === "tiktok" && (
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path
                        d="M14 3v11a4 4 0 1 1-4-4m4-7c.5 3 2.5 5 6 5"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                    </svg>
                  )}
                </Tag>
              );
            })}
          </div>
        </div>

        <p>
          Ihr Studio für professionelle Beauty-Behandlungen und individuelle
          Pflege.
        </p>
      </div>

      <!-- NAVIGATION -->

      <div class="footer-column footer-navigation">
        <h3>Navigation</h3>

        <nav aria-label="Footer Navigation">
          <ul>
            {navigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- CONTACT -->

      <div class="footer-column footer-contact-column">
        <h3>Kontakt</h3>

        <address class="footer-contact">
          <p>{contact.address}</p>

          {contact.phone && (
            <a href={`tel:${contact.phone.replace(/[\s()-]/g, "")}`}>
              {contact.phone}
            </a>
          )}

          {contact.email && (
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          )}

          {contact.instagram && (
            <a
              href={contact.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="desktop-instagram"
            >
              Instagram ↗
            </a>
          )}
        </address>
      </div>

      <!-- OPENING HOURS -->

      <div class="footer-column footer-hours">
        <h3>Öffnungszeiten</h3>

        <div class="opening-hours">
          {openingHours.map((item) => (
            <div class="hours-row">
              <span>{item.day}</span>
              <span>{item.hours}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- FOOTER BOTTOM -->

    <div class="footer-bottom">
      <p>© {currentYear} AlexandritHaus. Alle Rechte vorbehalten.</p>

      <div class="footer-legal">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </div>
    </div>

    <!-- MOBILE BOOKING BUTTON -->

    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="footer-booking-button"
    >
      TERMIN BUCHEN
    </a>
  </div>
</footer>

<style>
  /* =========================
     DESKTOP
     ========================= */

  .footer {
    width: 100%;
    padding: 65px 60px 25px;
    box-sizing: border-box;
    background: #e8dfe2;
    color: #292929;
  }

  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* MAIN GRID */

  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 45px;
    padding-bottom: 55px;
  }

  .footer-main > div {
    min-width: 0;
  }

  /* BRAND */

  .footer-logo {
    display: inline-block;
    margin-bottom: 20px;
    color: #292929;
    font-size: 27px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  .footer-logo span {
    color: #a87889;
  }

  .footer-brand p {
    max-width: 260px;
    margin: 0;
    color: #666;
    font-size: 13px;
    line-height: 1.7;
  }

  /* MOBILE SOCIALS — HIDDEN ON DESKTOP */

  .footer-socials {
    display: none;
  }

  /* COLUMNS */

  .footer-column h3 {
    margin: 0 0 22px;
    font-size: 15px;
    font-weight: 600;
    color: #292929;
  }

  .footer-column ul {
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer-column a {
    color: #555;
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .footer-column a:hover {
    color: #a87889;
  }

  /* CONTACT */

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    font-style: normal;
  }

  .footer-contact p {
    margin: 0;
    color: #555;
    font-size: 13px;
    line-height: 1.5;
  }

  /* OPENING HOURS */

  .opening-hours {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #555;
    font-size: 12px;
    line-height: 1.5;
  }

  .hours-row span:last-child {
    text-align: right;
  }

  /* FOOTER BOTTOM */

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 22px;
    border-top: 1px solid #cdbfc3;
  }

  .footer-bottom p {
    margin: 0;
    color: #777;
    font-size: 12px;
  }

  .footer-legal {
    display: flex;
    gap: 25px;
  }

  .footer-legal a {
    color: #666;
    font-size: 12px;
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: #a87889;
  }

  /* MOBILE BOOKING — HIDDEN ON DESKTOP */

  .footer-booking-button {
    display: none;
  }

  /* =========================
     TABLET
     ========================= */

  @media (max-width: 1000px) {
    .footer {
      padding: 50px 30px 25px;
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 600px) {
    .footer {
      padding: 24px 16px 20px;
      background: #292929;
      color: #ffffff;
    }

    .footer-inner {
      width: 100%;
      max-width: 100%;
    }

    .footer-main {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding-bottom: 20px;
    }

    /* MOBILE BLOCK ORDER */

    .footer-brand {
      order: 1;
    }

    .footer-contact-column {
      order: 2;
    }

    .footer-hours {
      order: 3;
    }

    .footer-navigation {
      order: 4;
    }

    /* LOGO AND SOCIALS */

    .footer-brand-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .footer-logo {
      margin: 0;
      color: #ffffff;
      font-size: 22px;
      font-weight: 600;
    }

    .footer-logo span {
      color: #e5cdd2;
    }

    .footer-brand p {
      max-width: 280px;
      color: #d4d4d4;
      font-size: 12px;
      line-height: 1.6;
    }

    /* SOCIAL ICONS */

    .footer-socials {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .footer-social-link {
      width: 32px;
      height: 32px;

      display: flex;
      align-items: center;
      justify-content: center;

      color: #ffffff;
      text-decoration: none;
    }

    .footer-social-link svg {
      width: 21px;
      height: 21px;
    }

    .social-disabled {
      opacity: 0.6;
    }

    .desktop-instagram {
      display: none;
    }

    /* MOBILE COLUMNS */

    .footer-column h3 {
      margin: 0 0 10px;
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
    }

    .footer-column ul {
      gap: 8px;
    }

    .footer-column a {
      color: #d4d4d4;
      font-size: 12px;
      line-height: 1.6;
    }

    /* MOBILE CONTACT */

    .footer-contact {
      gap: 6px;
    }

    .footer-contact p {
      color: #d4d4d4;
      font-size: 12px;
      line-height: 1.6;
    }

    /* MOBILE OPENING HOURS */

    .opening-hours {
      gap: 7px;
    }

    .hours-row {
      color: #d4d4d4;
      font-size: 12px;
      gap: 12px;
      line-height: 1.6;
    }

    /* MOBILE BOTTOM */

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid #555555;
    }

    .footer-bottom p {
      color: #bdbdbd;
      font-size: 11px;
      line-height: 1.5;
    }

    .footer-legal {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }

    .footer-legal a {
      color: #d4d4d4;
      font-size: 12px;
    }

    /* MOBILE BOOKING BUTTON */

    .footer-booking-button {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 100%;
      min-height: 44px;
      margin-top: 20px;
      padding: 12px 16px;
      box-sizing: border-box;

      background: #e5cdd2;
      color: #292929;
      border-radius: 30px;

      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
      text-decoration: none;
    }

    .footer-booking-button:hover {
      background: #d7bdc3;
    }
  }

  /* =========================
     SMALL PHONES
     ========================= */

  @media (max-width: 380px) {
    .footer {
      padding: 20px 12px 16px;
    }

    .footer-logo {
      font-size: 20px;
    }

    .footer-socials {
      gap: 4px;
    }

    .footer-social-link {
      width: 28px;
      height: 32px;
    }

    .footer-social-link svg {
      width: 19px;
      height: 19px;
    }
  }
</style>
