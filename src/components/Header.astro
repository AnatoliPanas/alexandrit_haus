<header class="site-header">
  <div class="header-inner">

    <!-- Logo -->
    <a href="/" class="logo">
      <img src="/image/logo.svg" alt="AlexandritHaus" />
    </a>

    <!-- Main navigation -->
    <nav class="main-navigation" aria-label="Hauptnavigation">

      <button class="nav-treatment" id="treatment-toggle"
        type="button" aria-expanded="false">
        Behandlungen
      </button>

      <button class="treatment-arrow" id="treatment-arrow"
        type="button" aria-label="Behandlungen öffnen">
        <span class="chevron"></span>
      </button>

      <a class="nav-about" href="#about">Über uns</a>
      <a class="nav-why" href="#why">Warum wir?</a>
      <a class="nav-process" href="#process">Ablauf</a>
      <a class="nav-faq" href="#faq">FAQ</a>
      <a class="nav-bewertungen" href="#bewertungen">Bewertungen</a>
      <a class="nav-footer" href="#footer">Kontakt</a>

    </nav>

    <!-- Booking button -->
    <button class="booking-button" type="button">
      TERMIN BUCHEN
    </button>

    <!-- Language selector -->
    <div class="language-selector">
      <button class="language-toggle" id="language-toggle"
        type="button" aria-expanded="false">
        <span id="current-language">DE</span>
        <span class="language-arrow">
          <span class="chevron"></span>
        </span>
      </button>

      <div class="language-menu" id="language-menu" hidden>
        <button type="button" data-language="DE">DE</button>
        <button type="button" data-language="RU">RU</button>
        <button type="button" data-language="UA">UA</button>
      </div>
    </div>

  </div>
</header>

<script>
  const treatmentToggle = document.querySelector("#treatment-toggle");
  const treatmentArrow = document.querySelector("#treatment-arrow");
  const languageToggle = document.querySelector("#language-toggle");
  const languageMenu = document.querySelector("#language-menu");
  const currentLanguage = document.querySelector("#current-language");

  function toggleTreatments() {
    const isOpen =
      treatmentToggle?.getAttribute("aria-expanded") === "true";

    treatmentToggle?.setAttribute("aria-expanded", String(!isOpen));
    treatmentArrow?.setAttribute("aria-expanded", String(!isOpen));
  }

  treatmentToggle?.addEventListener("click", toggleTreatments);
  treatmentArrow?.addEventListener("click", toggleTreatments);

  languageToggle?.addEventListener("click", () => {
    const isOpen = languageToggle.getAttribute("aria-expanded") === "true";

    languageToggle.setAttribute("aria-expanded", String(!isOpen));
    languageMenu.hidden = isOpen;
  });

  languageMenu?.querySelectorAll("button").forEach((button) => {
    button.addEventListener("click", () => {
      const language = button.dataset.language;

      if (!language) return;

      currentLanguage.textContent = language;
      languageMenu.hidden = true;
      languageToggle?.setAttribute("aria-expanded", "false");

      document.documentElement.lang =
        language === "UA" ? "uk" : language.toLowerCase();

      document.dispatchEvent(
        new CustomEvent("language-change", {
          detail: { language }
        })
      );
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (
      target instanceof Node &&
      !languageToggle?.contains(target) &&
      !languageMenu?.contains(target)
    ) {
      languageMenu.hidden = true;
      languageToggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>

