---
const categories = [
  {
    id: "haarentfernung",
    title: "Haarentfernung",
    treatments: [
      { zone: "Oberlippe", duration: "15 Min.", price: "29 €" },
      { zone: "Kinn", duration: "15 Min.", price: "29 €" },
      { zone: "Achseln", duration: "30 Min.", price: "49 €" },
      { zone: "Arme komplett", duration: "45 Min.", price: "79 €" },
      { zone: "Beine komplett", duration: "60 Min.", price: "99 €" },
      { zone: "Bikinizone", duration: "30 Min.", price: "59 €" },
    ],
  },
  {
    id: "elektro-epilation",
    title: "Elektro-Epilation",
    treatments: [
      { zone: "Kinn", duration: "15 Min.", price: "35 €" },
      { zone: "Oberlippe", duration: "15 Min.", price: "35 €" },
      { zone: "Gesicht", duration: "30 Min.", price: "65 €" },
      { zone: "Körper", duration: "45 Min.", price: "85 €" },
    ],
  },
  {
    id: "kosmetologie",
    title: "Kosmetologie",
    treatments: [
      { zone: "Gesichtsreinigung", duration: "60 Min.", price: "79 €" },
      { zone: "Hydra Facial", duration: "60 Min.", price: "99 €" },
      { zone: "Peeling", duration: "45 Min.", price: "69 €" },
      { zone: "Gesichtsmassage", duration: "30 Min.", price: "49 €" },
    ],
  },
  {
    id: "manikuere",
    title: "Maniküre",
    treatments: [
      { zone: "Maniküre klassisch", duration: "45 Min.", price: "39 €" },
      { zone: "Maniküre mit Lack", duration: "60 Min.", price: "49 €" },
      { zone: "Gel-Modellage", duration: "90 Min.", price: "69 €" },
      { zone: "Gel auffüllen", duration: "75 Min.", price: "59 €" },
    ],
  },
];
---

<section class="treatments" id="treatments">
  <div class="treatments-inner">
    <div class="treatments-header">
      <h2>Unsere Behandlungen</h2>
      <p>
        Entdecken Sie unsere Behandlungen und finden Sie das passende Angebot.
      </p>
    </div>
    <div
      class="category-tabs"
      role="tablist"
      aria-label="Behandlungskategorien"
    >
      {categories.map((category, index) => (
        <button
          class:list={["category-tab", { active: index === 0 }]}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          data-category={category.id}
        >
          {category.title}
        </button>
      ))}
    </div>
    {categories.map((category, index) => (
      <div
        class="treatments-panel"
        data-panel={category.id}
        role="tabpanel"
        hidden={index !== 0}
      >
        <div class="treatments-table">
          <div class="table-header">
            <span>Zone</span>
            <span>Dauer</span>
            <span>Preis</span>
            <span>Buchen</span>
          </div>

          {category.treatments.map((treatment) => (
            <div class="treatment-row">
              <span class="treatment-zone">{treatment.zone}</span>
              <span class="treatment-duration">{treatment.duration}</span>
              <span class="treatment-price">{treatment.price}</span>

              <div class="booking-actions">
                <a href="#" class="booking-button single">
                  Einzeln
                </a>
                <a href="#" class="booking-button package">
                  Paket
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".category-tab");
  const panels = document.querySelectorAll<HTMLElement>(".treatments-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const selectedCategory = tab.dataset.category;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== selectedCategory;
      });
    });
  });
</script>

<style>
  .treatments {
    width: 100%;
    background: #fff;
    padding: 80px 60px;
    box-sizing: border-box;
  }

  .treatments-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .treatments-header {
    margin-bottom: 40px;
  }

  .treatments-header h2 {
    margin: 0 0 14px;
    color: #292929;
    font-size: 32px;
    font-weight: 500;
  }

  .treatments-header p {
    margin: 0;
    color: #777;
    font-size: 15px;
    line-height: 1.6;
  }

  /* CATEGORY TABS */

  .category-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 35px;
    border-bottom: 1px solid #e8dfe2;
  }

  .category-tab {
    position: relative;
    padding: 18px 10px;
    border: none;
    background: transparent;
    color: #777;
    font-family: inherit;
    font-size: 15px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .category-tab:hover,
  .category-tab.active {
    color: #a66f83;
  }

  .category-tab.active {
    font-weight: 600;
  }

  .category-tab.active::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #b78396;
  }

  /* TABLE */

  .table-header,
  .treatment-row {
    display: grid;
    grid-template-columns: 2fr 1fr 0.8fr 1.5fr;
    align-items: center;
    gap: 20px;
  }

  .table-header {
    padding: 16px 20px;
    color: #888;
    font-size: 13px;
    font-weight: 600;
    border-bottom: 1px solid #e8dfe2;
  }

  .treatment-row {
    min-height: 78px;
    padding: 14px 20px;
    border-bottom: 1px solid #eee7e9;
    transition: background 0.2s;
  }

  .treatment-row:hover {
    background: #faf6f7;
  }

  .treatment-zone {
    color: #333;
    font-size: 15px;
    font-weight: 500;
  }

  .treatment-duration {
    color: #777;
    font-size: 14px;
  }

  .treatment-price {
    color: #333;
    font-size: 15px;
    font-weight: 600;
  }

  /* BOOKING BUTTONS */

  .booking-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-start;
  }

  .booking-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 75px;
    padding: 10px 15px;
    border-radius: 25px;
    font-size: 12px;
    text-decoration: none;
    transition: 0.2s;
  }

  .booking-button.single {
    background: #292929;
    color: #fff;
  }

  .booking-button.package {
    background: #ead9df;
    color: #704858;
  }

  .booking-button:hover {
    opacity: 0.8;
    transform: translateY(-1px);
  }

  .treatments-panel[hidden] {
    display: none;
  }

  /* TABLET */

  @media (max-width: 900px) {
    .treatments {
      padding: 60px 30px;
    }

    .table-header,
    .treatment-row {
      grid-template-columns: 1.5fr 0.8fr 0.7fr 1.5fr;
      gap: 10px;
    }

    .booking-button {
      min-width: 60px;
      padding: 9px 10px;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .treatments {
      padding: 45px 16px;
    }

    .treatments-header h2 {
      font-size: 25px;
    }

    .category-tabs {
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }

    .category-tab {
      padding: 15px 5px;
      font-size: 13px;
    }

    .table-header {
      display: none;
    }

    .treatment-row {
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 18px 5px;
    }

    .treatment-zone {
      grid-column: 1;
    }

    .treatment-duration {
      grid-column: 1;
      grid-row: 2;
      font-size: 12px;
    }

    .treatment-price {
      grid-column: 2;
      grid-row: 1;
      text-align: right;
    }

    .booking-actions {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 8px;
    }

    .booking-button {
      flex: 1;
    }
  }
</style>
