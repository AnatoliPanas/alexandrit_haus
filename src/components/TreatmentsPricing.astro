---
const bookingUrl = "https://alexandrithaus.sviigo.site";

const categories = [
  {
    id: "laser",
    title: "Laser-Haarentfernung",
    groups: [
      {
        name: "Gesicht",
        treatments: [
          { zone: "Oberlippe", duration: "5 Min.", price: "35 €" },
          { zone: "Kinn", duration: "10 Min.", price: "35 €" },
          { zone: "Gesicht komplett", duration: "20 Min.", price: "89 €" },
        ],
      },
      {
        name: "Körper",
        treatments: [
          { zone: "Achseln", duration: "10 Min.", price: "50 €" },
          { zone: "Arme komplett", duration: "25 Min.", price: "100 €" },
          { zone: "Beine komplett", duration: "35 Min.", price: "150 €" },
        ],
      },
      {
        name: "Intimbereich",
        treatments: [
          { zone: "Bikinizone", duration: "15 Min.", price: "65 €" },
          { zone: "Intim komplett", duration: "25 Min.", price: "95 €" },
        ],
      },
      {
        name: "Beine",
        treatments: [
          { zone: "Unterschenkel", duration: "20 Min.", price: "90 €" },
          { zone: "Oberschenkel", duration: "20 Min.", price: "95 €" },
        ],
      },
      {
        name: "Spezialzonen",
        treatments: [
          { zone: "Finger", duration: "5 Min.", price: "25 €" },
          { zone: "Zehen", duration: "5 Min.", price: "25 €" },
        ],
      },
    ],
  },
  {
    id: "electro",
    title: "Elektroepilation",
    groups: [
      {
        name: "Gesicht",
        treatments: [
          { zone: "Oberlippe", duration: "15 Min.", price: "35 €" },
          { zone: "Kinn", duration: "30 Min.", price: "60 €" },
        ],
      },
      {
        name: "Körper",
        treatments: [
          { zone: "Kleine Zone", duration: "30 Min.", price: "60 €" },
        ],
      },
    ],
  },
  {
    id: "cosmetic",
    title: "Kosmetologie",
    groups: [
      {
        name: "Gesichtsbehandlungen",
        treatments: [
          { zone: "Gesichtsreinigung", duration: "60 Min.", price: "79 €" },
          { zone: "Peeling", duration: "45 Min.", price: "69 €" },
        ],
      },
    ],
  },
  {
    id: "manicure",
    title: "Maniküre",
    groups: [
      {
        name: "Maniküre",
        treatments: [
          { zone: "Klassische Maniküre", duration: "45 Min.", price: "39 €" },
          { zone: "Maniküre mit Lack", duration: "60 Min.", price: "49 €" },
        ],
      },
    ],
  },
];
---

<section class="treatments" id="treatments">
  <div class="treatments-inner">
    <div class="treatments-heading">
      <h2>Laser-Haarentfernung</h2>
      <p>Preise & Zonen</p>
    </div>

    <!-- CATEGORY TABS -->
    <div
      class="category-tabs"
      role="tablist"
      aria-label="Behandlungskategorien"
    >
      {categories.map((category, index) => (
        <button
          type="button"
          class:list={["category-tab", { active: index === 0 }]}
          data-category={category.id}
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${category.id}`}
          id={`tab-${category.id}`}
        >
          {category.title}
        </button>
      ))}
    </div>

    <!-- CATEGORY PANELS -->
    {categories.map((category, categoryIndex) => (
      <div
        class="category-panel"
        id={`panel-${category.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${category.id}`}
        data-panel={category.id}
        hidden={categoryIndex !== 0}
      >
        <!-- DESKTOP TABLE -->
        <div class="desktop-table">
          <div class="table-heading">
            <span>Zone</span>
            <span>Dauer</span>
            <span>Preis</span>
            <span>Buchen</span>
          </div>

          {category.groups
            .flatMap((group) => group.treatments)
            .map((item) => (
              <div class="table-row">
                <span>{item.zone}</span>
                <span>{item.duration}</span>
                <span class="price">{item.price}</span>

                <div class="booking-actions">
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Einzeln
                  </a>
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Paket
                  </a>
                </div>
              </div>
            ))}
        </div>

        <!-- MOBILE ACCORDION -->
        <div class="mobile-groups">
          {category.groups.map((group, groupIndex) => (
            <details class="treatment-group" open={groupIndex === 0}>
              <summary>
                <span class="group-name">
                  <span class="group-circle"></span>
                  {group.name}
                </span>
                <span class="group-chevron" aria-hidden="true">
                  ⌄
                </span>
              </summary>

              <div class="group-content">
                <div class="mobile-table-heading">
                  <span>Zone</span>
                  <span>Dauer</span>
                  <span>Preis</span>
                </div>

                {group.treatments.map((item) => (
                  <div class="mobile-treatment-row">
                    <span>{item.zone}</span>
                    <span>{item.duration}</span>
                    <span>{item.price}</span>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}

    <a
      class="mobile-booking"
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Termin buchen
    </a>
  </div>
</section>

<script>
  const treatmentSections =
    document.querySelectorAll<HTMLElement>(".treatments");

  treatmentSections.forEach((section) => {
    const tabs = section.querySelectorAll<HTMLButtonElement>(".category-tab");
    const panels = section.querySelectorAll<HTMLElement>(".category-panel");
    const heading = section.querySelector<HTMLElement>(
      ".treatments-heading h2",
    );

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selected = tab.dataset.category;

        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("active", active);
          item.setAttribute("aria-selected", String(active));
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== selected;
        });

        if (heading) heading.textContent = tab.textContent?.trim() ?? "";
      });
    });
  });
</script>

<style>
  .treatments {
    width: 100%;
    padding: 60px;
    box-sizing: border-box;
    background: #fff;
  }

  .treatments-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .treatments-heading h2 {
    margin: 0 0 5px;
    font-size: 28px;
    font-weight: 500;
    color: #292929;
  }

  .treatments-heading p {
    margin: 0 0 28px;
    font-size: 16px;
    color: #777;
  }

  .category-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 28px;
    border-bottom: 1px solid #eee;
  }

  .category-tab {
    flex: 1;
    padding: 15px 10px;
    border: none;
    background: transparent;
    color: #777;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .category-tab.active {
    color: #a87889;
    border-bottom: 2px solid #a87889;
  }

  .category-panel[hidden] {
    display: none !important;
  }

  /* DESKTOP TABLE */

  .table-heading,
  .table-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    align-items: center;
    gap: 20px;
  }

  .table-heading {
    padding: 15px 20px;
    border-bottom: 1px solid #ddd;
    font-size: 13px;
    color: #777;
  }

  .table-row {
    padding: 15px 20px;
    border-bottom: 1px solid #eee;
    font-size: 14px;
  }

  .price {
    font-weight: 600;
  }

  .booking-actions {
    display: flex;
    gap: 8px;
  }

  .booking-actions a {
    padding: 9px 14px;
    border-radius: 25px;
    background: #ead9df;
    color: #292929;
    font-size: 12px;
    text-decoration: none;
  }

  .booking-actions a:first-child {
    background: #292929;
    color: white;
  }

  .mobile-groups,
  .mobile-booking {
    display: none;
  }

  /* TABLET */

  @media (max-width: 900px) {
    .treatments {
      padding: 40px 30px;
    }

    .table-heading,
    .table-row {
      gap: 10px;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .treatments {
      padding: 25px 12px;
      background: #fbe9eb;
    }

    .treatments-heading h2 {
      font-size: 23px;
    }

    .treatments-heading p {
      margin-bottom: 15px;
      font-size: 18px;
      color: #292929;
    }

    .category-tabs {
      gap: 5px;
      margin-bottom: 18px;
      padding-bottom: 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .category-tabs::-webkit-scrollbar {
      display: none;
    }

    .category-tab {
      flex: 0 0 auto;
      padding: 9px 14px;
      border-radius: 20px;
      background: #dfc9cd;
      font-size: 12px;
      white-space: nowrap;
    }

    .category-tab.active {
      background: #b9a3a8;
      border-bottom: none;
      color: #fff;
    }

    .desktop-table {
      display: none;
    }

    .mobile-groups {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .treatment-group {
      overflow: hidden;
      border-radius: 12px;
      background: #ead4d8;
    }

    .treatment-group summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 42px;
      padding: 9px 12px;
      list-style: none;
      cursor: pointer;
      font-size: 13px;
    }

    .treatment-group summary::-webkit-details-marker {
      display: none;
    }

    .group-name {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .group-circle {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #f8e9ec;
      flex-shrink: 0;
    }

    .group-chevron {
      font-size: 20px;
      transition: transform 0.2s;
    }

    .treatment-group[open] .group-chevron {
      transform: rotate(180deg);
    }

    .group-content {
      padding: 5px 12px 15px 36px;
    }

    .mobile-table-heading,
    .mobile-treatment-row {
      display: grid;
      grid-template-columns: 1.5fr 1fr 0.8fr;
      gap: 6px;
    }

    .mobile-table-heading {
      margin-bottom: 10px;
      color: #999;
      font-size: 10px;
    }

    .mobile-treatment-row {
      padding: 5px 0;
      font-size: 11px;
      color: #333;
    }

    .mobile-treatment-row span:last-child {
      text-align: right;
      font-weight: 600;
    }

    .mobile-booking {
      display: block;
      width: 100%;
      margin-top: 14px;
      padding: 13px;
      box-sizing: border-box;
      border-radius: 8px;
      background: #c5a8ae;
      color: #292929;
      text-align: center;
      font-size: 13px;
      text-decoration: none;
    }
  }
</style>
