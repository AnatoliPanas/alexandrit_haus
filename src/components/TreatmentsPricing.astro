---
const bookingUrl = "https://alexandrithaus.sviigo.site";
const iconPath = "/images/treatments";

const groupIcons: Record<string, string> = {
  Gesicht: "face.png",
  Körper: "body.png",
  Intimbereich: "intimate.png",
  Beine: "legs.png",
  Spezialzonen: "special.png",
  Gesichtsbehandlungen: "face.png",
  Maniküre: "special.png",
};

const categories = [
  {
    id: "laser",
    title: "Laser-Haarentfernung",
    groups: [
      {
        name: "Gesicht",
        treatments: [
          { zone: "Oberlippe", duration: "5 Min.", price: "35 €" },
          { zone: "Kinn", duration: "10 Min.", price: "35 €" },
          { zone: "Gesicht komplett", duration: "20 Min.", price: "89 €" },
        ],
      },
      {
        name: "Körper",
        treatments: [
          { zone: "Achseln", duration: "10 Min.", price: "50 €" },
          { zone: "Arme komplett", duration: "25 Min.", price: "100 €" },
          { zone: "Beine komplett", duration: "35 Min.", price: "150 €" },
        ],
      },
      {
        name: "Intimbereich",
        treatments: [
          { zone: "Bikinizone", duration: "15 Min.", price: "65 €" },
          { zone: "Intim komplett", duration: "25 Min.", price: "95 €" },
        ],
      },
      {
        name: "Beine",
        treatments: [
          { zone: "Unterschenkel", duration: "20 Min.", price: "90 €" },
          { zone: "Oberschenkel", duration: "20 Min.", price: "95 €" },
        ],
      },
      {
        name: "Spezialzonen",
        treatments: [
          { zone: "Finger", duration: "5 Min.", price: "25 €" },
          { zone: "Zehen", duration: "5 Min.", price: "25 €" },
        ],
      },
    ],
  },
  {
    id: "manicure",
    title: "Maniküre",
    groups: [
      {
        name: "Maniküre",
        treatments: [
          { zone: "Klassische Maniküre", duration: "45 Min.", price: "39 €" },
          { zone: "Maniküre mit Lack", duration: "60 Min.", price: "49 €" },
        ],
      },
    ],
  },
  {
    id: "cosmetic",
    title: "Kosmetologie",
    groups: [
      {
        name: "Gesichtsbehandlungen",
        treatments: [
          { zone: "Gesichtsreinigung", duration: "60 Min.", price: "79 €" },
          { zone: "Peeling", duration: "45 Min.", price: "69 €" },
        ],
      },
    ],
  },
  {
    id: "electro",
    title: "Elektroepilation",
    groups: [
      {
        name: "Gesicht",
        treatments: [
          { zone: "Oberlippe", duration: "15 Min.", price: "35 €" },
          { zone: "Kinn", duration: "30 Min.", price: "60 €" },
        ],
      },
      {
        name: "Körper",
        treatments: [
          { zone: "Kleine Zone", duration: "30 Min.", price: "60 €" },
        ],
      },
    ],
  },
];
---

<section class="treatments" id="treatments">
  <div class="treatments-inner">
    <!-- CATEGORY TABS -->

    <div
      class="category-tabs"
      role="tablist"
      aria-label="Behandlungskategorien"
    >
      {categories.map((category, index) => (
        <button
          type="button"
          class:list={["category-tab", { active: index === 0 }]}
          data-category={category.id}
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${category.id}`}
          id={`tab-${category.id}`}
          tabindex={index === 0 ? 0 : -1}
        >
          {category.title}
        </button>
      ))}
    </div>

    <!-- HEADING -->

    <div class="treatments-heading">
      <p class="category-title">Laser-Haarentfernung</p>
      <h2>Preise &amp; Zonen</h2>
    </div>

    <!-- CATEGORY PANELS -->

    {categories.map((category, categoryIndex) => (
      <div
        class="category-panel"
        id={`panel-${category.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${category.id}`}
        data-panel={category.id}
        hidden={categoryIndex !== 0}
      >
        <!-- DESKTOP TABLE -->

        <div class="desktop-table">
          <div class="table-heading">
            <span>Zone</span>
            <span>Dauer</span>
            <span>Preis</span>
            <span>Buchen</span>
          </div>

          {category.groups
            .flatMap((group) => group.treatments)
            .map((item) => (
              <div class="table-row">
                <span>{item.zone}</span>
                <span>{item.duration}</span>
                <span class="price">{item.price}</span>

                <div class="booking-actions">
                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.zone} einzeln buchen`}
                  >
                    Einzeln
                  </a>

                  <a
                    href={bookingUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${item.zone} als Paket buchen`}
                  >
                    Paket
                  </a>
                </div>
              </div>
            ))}
        </div>

        <!-- TABLET & MOBILE ACCORDIONS -->

        <div class="mobile-groups">
          {category.groups.map((group, groupIndex) => (
            <details class="treatment-group" open={groupIndex < 2}>
              <summary>
                <span class="group-name">
                  <span class="group-icon">
                    <img
                      src={`${iconPath}/${groupIcons[group.name] || "special.png"}`}
                      alt=""
                      aria-hidden="true"
                    />
                  </span>

                  {group.name}
                </span>

                <span class="group-chevron" aria-hidden="true">
                  <img src={`${iconPath}/chevron.png`} alt="" />
                </span>
              </summary>

              <div class="group-content">
                <div class="mobile-table-heading">
                  <span>Zone</span>
                  <span>Dauer</span>
                  <span>Preis</span>
                  <span />
                </div>

                {group.treatments.map((item) => (
                  <div class="mobile-treatment-row">
                    <span class="treatment-zone">{item.zone}</span>

                    <span class="treatment-duration">{item.duration}</span>

                    <span class="treatment-price">{item.price}</span>

                    <a
                      class="treatment-booking"
                      href={bookingUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${item.zone} buchen`}
                    >
                      <img
                        src={`${iconPath}/booking.png`}
                        alt=""
                        aria-hidden="true"
                      />
                    </a>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}

    <!-- MAIN BOOKING BUTTON -->

    <a
      class="main-booking"
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      JETZT TERMIN BUCHEN
      <span class="booking-arrow" aria-hidden="true">
        <img src={`${iconPath}/booking.png`} alt="" />
      </span>
    </a>
  </div>
</section>

<script>
  const treatmentSections =
    document.querySelectorAll<HTMLElement>(".treatments");

  treatmentSections.forEach((section) => {
    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>(".category-tab"),
    );

    const panels = section.querySelectorAll<HTMLElement>(".category-panel");

    const heading = section.querySelector<HTMLElement>(".category-title");

    function activateTab(tab: HTMLButtonElement) {
      const selected = tab.dataset.category;

      tabs.forEach((item) => {
        const active = item === tab;

        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== selected;
      });

      if (heading) {
        heading.textContent = tab.textContent?.trim() ?? "";
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activateTab(tab);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;

        switch (event.key) {
          case "ArrowRight":
            nextIndex = (index + 1) % tabs.length;
            break;

          case "ArrowLeft":
            nextIndex = (index - 1 + tabs.length) % tabs.length;
            break;

          case "Home":
            nextIndex = 0;
            break;

          case "End":
            nextIndex = tabs.length - 1;
            break;

          default:
            return;
        }

        event.preventDefault();

        tabs[nextIndex].focus();
        activateTab(tabs[nextIndex]);
      });
    });
  });
</script>

<style>
  /* ==============================
     SECTION
  ============================== */

  .treatments {
    width: 100%;
    padding: 60px 40px;
    background: var(--color-background, #fff9f5);
    font-family: var(--font-body, "Manrope", sans-serif);
    color: var(--color-heading, #250702);
  }

  .treatments-inner {
    width: 100%;
    max-width: 1200px;
    min-width: 0;
    margin: 0 auto;
  }

  /* ==============================
     CATEGORY TABS
  ============================== */

  .category-tabs {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 3px 3px 5px;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  .category-tab {
    flex: 1 0 auto;
    padding: 12px 20px;
    border: 1px solid #eed9d9;
    border-radius: 50px;
    background: #fff8f7;
    color: #65464a;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .category-tab:hover {
    background: #fcefed;
  }

  .category-tab.active {
    background: var(--color-rose, #c27e8f);
    border-color: var(--color-rose, #c27e8f);
    color: #fff;
  }

  /* ==============================
     HEADING
  ============================== */

  .treatments-heading {
    margin-bottom: 24px;
  }

  .category-title {
    margin: 0 0 3px;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 1.6px;
    color: #65464a;
  }

  .treatments-heading h2 {
    margin: 0;
    font-family: var(--font-heading, "Prata", serif);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: 2px;
    line-height: 1.35;
    color: #250702;
  }

  .category-panel[hidden] {
    display: none !important;
  }

  /* ==============================
     DESKTOP TABLE
  ============================== */

  .desktop-table {
    padding: 16px 24px;
    border: 1px solid #eed9d9;
    border-radius: 16px;
    background: #fff8f7;
  }

  .table-heading,
  .table-row {
    display: grid;
    grid-template-columns:
      minmax(0, 2fr)
      minmax(0, 1fr)
      minmax(0, 1fr)
      minmax(180px, 1.3fr);
    align-items: center;
    gap: 20px;
  }

  .table-heading {
    padding: 12px 0;
    border-bottom: 1px solid #eed9d9;
    font-size: 13px;
    color: #948582;
  }

  .table-row {
    min-height: 64px;
    padding: 12px 0;
    border-bottom: 1px solid #eed9d9;
    font-size: 16px;
    color: #250702;
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .price {
    font-weight: 500;
  }

  .booking-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .booking-actions a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 80px;
    min-height: 36px;
    padding: 8px 16px;
    border: 1px solid #c27e8f;
    border-radius: 50px;
    background: transparent;
    color: #a96075;
    font-size: 13px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .booking-actions a:first-child {
    background: #c27e8f;
    color: #fff;
  }

  .booking-actions a:hover {
    background: #a96075;
    color: #fff;
  }

  /* ==============================
     MAIN BOOKING BUTTON
  ============================== */

  .main-booking {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    max-width: 360px;
    min-height: 46px;
    margin: 24px auto 0;
    padding: 8px 20px;
    border-radius: 50px;
    background: var(--color-rose, #c27e8f);
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .main-booking:hover {
    background: var(--color-rose-hover, #a96075);
  }

  .main-booking:active {
    background: var(--color-rose-pressed, #87495e);
  }

  .booking-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 25px;
    height: 25px;
    flex-shrink: 0;
  }

  .booking-arrow img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  .mobile-groups {
    display: none;
  }

  /* ==============================
     TABLET
  ============================== */

  @media (max-width: 1100px) {
    .treatments {
      padding: 40px 32px;
    }

    .category-tabs {
      gap: 8px;
      margin-bottom: 24px;
    }

    .category-tab {
      flex: 0 0 auto;
      padding: 8px 16px;
      font-size: 14px;
    }

    .treatments-heading {
      margin-bottom: 16px;
    }

    .treatments-heading h2 {
      font-size: 32px;
    }

    .desktop-table {
      display: none;
    }

    .mobile-groups {
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    /* ACCORDION */

    .treatment-group {
      width: 100%;
      min-width: 0;
      padding: 7px;
      border: 1px solid #eed9d9;
      border-radius: 8px;
      background: #fff8f7;
    }

    .treatment-group summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 30px;
      gap: 10px;
      list-style: none;
      cursor: pointer;
      font-size: 16px;
      color: #250702;
    }

    .treatment-group summary::-webkit-details-marker {
      display: none;
    }

    .treatment-group summary::marker {
      content: "";
    }

    .group-name {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .group-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #fcefed;
    }

    .group-icon img {
      display: block;
      width: auto;
      height: auto;
      max-width: 24px;
      max-height: 24px;
      object-fit: contain;
    }

    .group-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      transform: rotate(180deg);
      transition: transform 0.2s ease;
    }

    .group-chevron img {
      width: auto;
      height: auto;
      max-width: 24px;
      max-height: 24px;
    }

    .treatment-group[open] .group-chevron {
      transform: rotate(0deg);
    }

    /* ACCORDION CONTENT */

    .group-content {
      padding-top: 7px;
    }

    .mobile-table-heading,
    .mobile-treatment-row {
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 0.4fr)
        minmax(0, 0.35fr)
        43px;
      align-items: center;
      gap: 12px;
    }

    .mobile-table-heading {
      margin-bottom: 10px;
      font-size: 12px;
      color: #948582;
    }

    .mobile-treatment-row {
      min-height: 43px;
      padding: 8px 0;
      border-bottom: 1px solid #eed9d9;
      font-size: 16px;
      font-weight: 400;
      color: #250702;
    }

    .mobile-treatment-row:first-of-type {
      padding-top: 0;
    }

    .mobile-treatment-row:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .treatment-zone {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .treatment-duration,
    .treatment-price {
      white-space: nowrap;
    }

    /* ROUND BOOKING BUTTON */

    .treatment-booking {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 43px;
      height: 43px;
      border-radius: 50%;
      background: #c27e8f;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .treatment-booking img {
      display: block;
      width: auto;
      height: auto;
      max-width: 26.16px;
      max-height: 26.16px;
      object-fit: contain;
    }

    .treatment-booking:hover {
      background: #a96075;
    }

    .treatment-booking:active {
      background: #87495e;
    }

    .main-booking {
      max-width: none;
      margin-top: 16px;
    }
  }

  /* ==============================
     MOBILE
  ============================== */

  @media (max-width: 700px) {
    .treatments {
      padding: 25px 20px;
    }

    .category-tabs {
      gap: 5px;
      margin-bottom: 24px;
    }

    .category-tab {
      min-height: 30px;
      padding: 5px 11px;
      font-size: 13px;
      line-height: 18px;
    }

    .treatments-heading {
      margin-bottom: 10px;
    }

    .category-title {
      font-size: 16px;
      line-height: 22px;
      letter-spacing: 1.6px;
    }

    .treatments-heading h2 {
      font-size: 20px;
      line-height: 27px;
      letter-spacing: 2px;
    }

    .treatment-group summary {
      font-size: 14px;
    }

    .mobile-table-heading,
    .mobile-treatment-row {
      grid-template-columns:
        minmax(0, 1fr)
        58px
        48px
        43px;
      gap: 8px;
    }

    .mobile-table-heading {
      font-size: 10px;
    }

    .mobile-treatment-row {
      font-size: 14px;
      line-height: 1.4;
    }

    .main-booking {
      min-height: 44px;
      font-size: 14px;
    }
  }

  /* ==============================
     SMALL MOBILE
  ============================== */

  @media (max-width: 360px) {
    .treatments {
      padding-inline: 12px;
    }

    .mobile-table-heading,
    .mobile-treatment-row {
      grid-template-columns:
        minmax(0, 1fr)
        48px
        42px
        43px;
      gap: 5px;
    }

    .mobile-treatment-row {
      font-size: 12px;
    }

    .category-tab {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-tab,
    .booking-actions a,
    .group-chevron,
    .treatment-booking,
    .main-booking {
      transition: none;
    }
  }
</style>
