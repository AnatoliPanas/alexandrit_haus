---
const bookingUrl = "https://alexandrithaus.sviigo.site";
---

<section class="booking-cta" id="booking">
  <div class="booking-inner">
    <div class="booking-content">
      <h2>
        Zeit für Ihre <span>Schönheit.</span>
      </h2>

      <p>
        Gönnen Sie sich eine Auszeit und entdecken Sie unsere professionellen
        Beauty-Behandlungen. Wir freuen uns auf Ihren Besuch!
      </p>

      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="booking-button"
      >
        JETZT TERMIN BUCHEN
        <span class="booking-arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* =========================
     DESKTOP
     ========================= */

  .booking-cta {
    width: 100%;
    padding: 35px 60px 65px;
    box-sizing: border-box;
    background: #ffffff;
  }

  .booking-inner {
    max-width: 1320px;
    min-height: 280px;
    margin: 0 auto;
    padding: 50px 60px;
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #dedede;
    border-radius: 12px;
    text-align: center;
  }

  .booking-content {
    width: 100%;
    max-width: 650px;

    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* HEADING */

  .booking-content h2 {
    margin: 0 0 18px;
    color: #292929;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
  }

  .booking-content h2 span {
    font-style: normal;
  }

  /* DESCRIPTION */

  .booking-content p {
    max-width: 520px;
    margin: 0 0 28px;

    color: #555555;
    font-size: 14px;
    line-height: 1.7;
  }

  /* BOOKING BUTTON */

  .booking-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;

    min-height: 44px;
    padding: 12px 24px;
    box-sizing: border-box;

    background: #292929;
    color: #ffffff;
    border-radius: 30px;

    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-decoration: none;

    transition:
      background 0.2s,
      transform 0.2s;
  }

  .booking-button:hover {
    background: #805665;
    transform: translateY(-2px);
  }

  .booking-arrow {
    font-size: 18px;
  }

  .booking-button:focus-visible {
    outline: 2px solid #805665;
    outline-offset: 4px;
  }

  /* =========================
     TABLET
     ========================= */

  @media (max-width: 900px) {
    .booking-cta {
      padding: 30px;
    }

    .booking-inner {
      padding: 45px 30px;
    }
  }

  /* =========================
     MOBILE — FIGMA
     ========================= */

  @media (max-width: 600px) {
    .booking-cta {
      width: 100%;
      padding: 18px 10px 24px;
      background: #ffffff;
    }

    .booking-inner {
      width: 100%;
      max-width: 100%;
      min-height: 0;

      margin: 0;
      padding: 0;

      background: transparent;
      border-radius: 0;
    }

    .booking-content {
      width: 100%;
      max-width: 100%;
    }

    /* MOBILE HEADING */

    .booking-content h2 {
      margin: 0 0 12px;

      color: #292929;
      font-size: 23px;
      font-weight: 500;
      line-height: 1.2;
      text-align: center;
    }

    .booking-content h2 span {
      font-style: italic;
    }

    /* MOBILE DESCRIPTION */

    .booking-content p {
      width: 100%;
      max-width: 340px;
      margin: 0 0 14px;

      color: #555555;
      font-size: 12px;
      line-height: 1.5;
      text-align: center;
    }

    /* MOBILE BUTTON */

    .booking-button {
      width: 100%;
      max-width: 360px;
      min-height: 44px;

      padding: 10px 16px;
      gap: 0;

      background: #e5cdd2;
      color: #292929;
      border-radius: 30px;

      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .booking-button:hover {
      background: #d7bdc3;
      transform: none;
    }

    .booking-arrow {
      display: none;
    }
  }

  /* =========================
     SMALL PHONES
     ========================= */

  @media (max-width: 380px) {
    .booking-content h2 {
      font-size: 21px;
    }

    .booking-content p {
      font-size: 11px;
    }

    .booking-button {
      font-size: 10px;
    }
  }
</style>
