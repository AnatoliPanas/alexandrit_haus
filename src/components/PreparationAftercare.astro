---
const beforeLong = [
  {
    title: "Keine intensive Sonnenexposition",
    description: "Vermeiden Sie direkte Sonneneinstrahlung und Solarium.",
    image: "sun",
  },
  {
    title: "Keine Haarentfernung mit der Wurzel",
    description: "Verzichten Sie auf Waxing, Epilation und Sugaring.",
    image: "skin",
  },
];

const beforeAppointment = [
  {
    title: "Haut rasieren",
    description: "Rasieren Sie die Behandlungszone 24 Stunden vor dem Termin.",
    image: "razor",
  },
  {
    title: "Haut sauber halten",
    description:
      "Verwenden Sie keine Cremes, Öle oder Deodorants auf der Behandlungszone.",
    image: "clean",
  },
];

const afterLaser = [
  {
    title: "Keine starke Hitze",
    description: "Verzichten Sie auf Sauna, Dampfbad und heiße Bäder.",
    image: "heat",
  },
  {
    title: "Sonnenschutz verwenden",
    description: "Schützen Sie die behandelte Haut vor direkter Sonne.",
    image: "spf",
  },
  {
    title: "Haut sanft pflegen",
    description: "Verwenden Sie eine milde und beruhigende Pflege.",
    image: "care",
  },
  {
    title: "Sport vermeiden",
    description:
      "Verzichten Sie zunächst auf intensives Training und starkes Schwitzen.",
    image: "sport",
  },
];

const beforeAll = [...beforeLong, ...beforeAppointment];
---

<section class="preparation" id="preparation">
  <div class="preparation-inner">
    <div class="section-heading">
      <span class="section-eyebrow">VORBEREITUNG & NACHSORGE</span>
      <h2>
        Für ein sicheres
        <br />
        und optimales Ergebnis
      </h2>
      <p>
        Für ein optimales Behandlungsergebnis beachten Sie bitte unsere
        Empfehlungen vor und nach der Laserbehandlung.
      </p>
    </div>

    <div class="preparation-columns">
      <!-- BEFORE LASER -->
      <div class="preparation-column">
        <div class="column-heading">
          <span class="column-number">01</span>
          <div>
            <h3>Vor dem Laser</h3>
            <p>3–4 Wochen vor der Behandlung</p>
          </div>
        </div>

        <!-- DESKTOP -->
        <div class="desktop-recommendations">
          <div class="recommendation-group">
            <h4>3–4 Wochen vor der Behandlung</h4>

            <div class="recommendation-grid">
              {beforeLong.map((item) => (
                <article class="recommendation-card">
                  <div class="recommendation-image">
                    <div class={`image-placeholder ${item.image}`}>
                      <span>Foto</span>
                    </div>
                  </div>
                  <div class="recommendation-info">
                    <h5>{item.title}</h5>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="recommendation-group">
            <h4>Kurz vor Ihrem Termin</h4>

            <div class="recommendation-grid">
              {beforeAppointment.map((item) => (
                <article class="recommendation-card">
                  <div class="recommendation-image">
                    <div class={`image-placeholder ${item.image}`}>
                      <span>Foto</span>
                    </div>
                  </div>
                  <div class="recommendation-info">
                    <h5>{item.title}</h5>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <!-- MOBILE -->
        <div class="mobile-recommendations">
          {beforeAll.map((item) => (
            <article class="mobile-recommendation">
              <div class={`mobile-image ${item.image}`}></div>
              <div class="mobile-info">
                <h4>{item.title}</h4>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- AFTER LASER -->
      <div class="preparation-column after-column">
        <div class="column-heading">
          <span class="column-number">02</span>
          <div>
            <h3>Nach dem Laser</h3>
            <p>Erste 24–48 Stunden</p>
          </div>
        </div>

        <!-- DESKTOP -->
        <div class="desktop-recommendations">
          <div class="recommendation-group">
            <h4>Erste 24–48 Stunden</h4>

            <div class="recommendation-grid">
              {afterLaser.map((item) => (
                <article class="recommendation-card">
                  <div class="recommendation-image">
                    <div class={`image-placeholder ${item.image}`}>
                      <span>Foto</span>
                    </div>
                  </div>
                  <div class="recommendation-info">
                    <h5>{item.title}</h5>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <!-- MOBILE -->
        <div class="mobile-recommendations">
          {afterLaser.map((item) => (
            <article class="mobile-recommendation">
              <div class={`mobile-image ${item.image}`}></div>
              <div class="mobile-info">
                <h4>{item.title}</h4>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* =====================
     DESKTOP
     ===================== */

  .preparation {
    width: 100%;
    padding: 80px 60px;
    box-sizing: border-box;
    background: #f8f5f4;
  }

  .preparation-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .section-heading {
    margin-bottom: 45px;
  }

  .section-eyebrow {
    display: none;
  }

  .section-heading h2 {
    margin: 0 0 14px;
    font-size: 32px;
    font-weight: 500;
    color: #292929;
  }

  .section-heading h2 br {
    display: none;
  }

  .section-heading p {
    max-width: 600px;
    margin: 0;
    color: #777;
    font-size: 15px;
    line-height: 1.6;
  }

  .preparation-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: stretch;
  }

  .preparation-column {
    min-width: 0;
    padding: 30px;
    background: #fff;
    border-radius: 12px;
  }

  .after-column {
    background: #f1e7e9;
  }

  .column-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 22px;
    margin-bottom: 28px;
    border-bottom: 1px solid #e8dfe2;
  }

  .column-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #ead9df;
    color: #805665;
    font-size: 13px;
  }

  .column-heading h3 {
    margin: 0;
    font-size: 23px;
    font-weight: 500;
    color: #292929;
  }

  .column-heading > div > p {
    display: none;
  }

  .recommendation-group {
    margin-bottom: 35px;
  }

  .recommendation-group:last-child {
    margin-bottom: 0;
  }

  .recommendation-group h4 {
    margin: 0 0 18px;
    font-size: 16px;
    font-weight: 600;
    color: #444;
  }

  .recommendation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .recommendation-card {
    min-width: 0;
    overflow: hidden;
    background: #faf8f7;
    border-radius: 9px;
  }

  .recommendation-image {
    width: 100%;
    height: 145px;
    overflow: hidden;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8dfe2;
    color: #977c85;
    font-size: 13px;
    transition: transform 0.3s;
  }

  .recommendation-card:hover .image-placeholder {
    transform: scale(1.04);
  }

  .image-placeholder.sun,
  .mobile-image.sun {
    background: #eee3d5;
  }

  .image-placeholder.skin,
  .mobile-image.skin {
    background: #eadbd5;
  }

  .image-placeholder.razor,
  .mobile-image.razor {
    background: #e4dce0;
  }

  .image-placeholder.clean,
  .mobile-image.clean {
    background: #e5e8e3;
  }

  .image-placeholder.heat,
  .mobile-image.heat {
    background: #eadbd7;
  }

  .image-placeholder.spf,
  .mobile-image.spf {
    background: #eee5d6;
  }

  .image-placeholder.care,
  .mobile-image.care {
    background: #e1e8e1;
  }

  .image-placeholder.sport,
  .mobile-image.sport {
    background: #e3e0e8;
  }

  .recommendation-info {
    padding: 15px;
  }

  .recommendation-info h5 {
    margin: 0 0 8px;
    color: #333;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .recommendation-info p {
    margin: 0;
    color: #777;
    font-size: 12px;
    line-height: 1.6;
  }

  .mobile-recommendations {
    display: none;
  }

  /* =====================
     TABLET
     ===================== */

  @media (max-width: 1000px) {
    .preparation {
      padding: 60px 30px;
    }

    .preparation-columns {
      gap: 18px;
    }

    .preparation-column {
      padding: 22px;
    }

    .recommendation-grid {
      gap: 10px;
    }

    .recommendation-image {
      height: 120px;
    }
  }

  /* =====================
     MOBILE — FIGMA
     ===================== */

  @media (max-width: 700px) {
    .preparation {
      padding: 20px 10px 24px;
      background: #fff;
    }

    .preparation-inner {
      max-width: 100%;
    }

    /* TITLE */

    .section-heading {
      margin-bottom: 14px;
    }

    .section-eyebrow {
      display: block;
      margin-bottom: 3px;
      color: #805665;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 23px;
      line-height: 1.08;
      font-weight: 600;
    }

    .section-heading h2 br {
      display: initial;
    }

    .section-heading p {
      display: none;
    }

    /* TWO VERTICAL BLOCKS */

    .preparation-columns {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .preparation-column,
    .after-column {
      width: 100%;
      padding: 12px 10px;
      background: #f0dfe2;
      border-radius: 8px;
    }

    /* BLOCK HEADINGS */

    .column-heading {
      gap: 10px;
      padding: 0;
      margin-bottom: 12px;
      border: none;
    }

    .column-number {
      width: 22px;
      height: 22px;
      font-size: 9px;
      background: #ddc2c9;
    }

    .column-heading h3 {
      font-size: 13px;
      font-weight: 600;
      line-height: 1.2;
    }

    .column-heading > div > p {
      display: block;
      margin: 3px 0 0;
      font-size: 9px;
      color: #777;
    }

    /* HIDE DESKTOP CARDS */

    .desktop-recommendations {
      display: none;
    }

    /* MOBILE RECOMMENDATIONS */

    .mobile-recommendations {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .mobile-recommendation {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 42px;
    }

    .mobile-image {
      width: 36px;
      height: 36px;
      min-width: 36px;
      border-radius: 50%;
    }

    .mobile-info {
      min-width: 0;
      flex: 1;
    }

    .mobile-info h4 {
      margin: 0 0 3px;
      font-size: 10px;
      font-weight: 600;
      line-height: 1.3;
      color: #292929;
    }

    .mobile-info p {
      margin: 0;
      font-size: 9px;
      line-height: 1.35;
      color: #666;
    }
  }
</style>
