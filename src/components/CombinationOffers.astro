---
const offers = [
  {
    id: 1,
    title: "First Combination",
    description: "First description",
    price: "99 €",
  },

  {
    id: 2,
    title: "Second Combination",
    description: "Second description",
    price: "99 €",
  },
  {
    id: 3,
    title: "Bikini & Achseln",
    description: "Beliebtes Behandlungspaket",
    price: "69 €",
  },
];
---

<section class="combination-offers" id="offers">
  <div class="offers-intro">
    <h2>Unsere beliebten Behandlungspakete</h2>

    <p>
      Entdecken Sie unsere beliebtesten Kombinationen und finden Sie Ihr
      passendes Angebot.
    </p>

    <a
      href="https://alexandrithaus.sviigo.site"
      target="_blank"
      rel="noopener noreferrer"
      class="offers-button"
    >
      Jetzt buchen
    </a>
  </div>

  <div class="offers-content">
    <div class="offers-list">
      {offers.map((offer) => (
        <article class="offer-card">
          <div class="offer-image">
            <span>Foto</span>
          </div>

          <div class="offer-info">
            <h3>{offer.title}</h3>
            <p>{offer.description}</p>
            <span class="offer-price">{offer.price}</span>
          </div>

          <a
            href="https://alexandrithaus.sviigo.site"
            target="_blank"
            rel="noopener noreferrer"
            class="offer-arrow"
            aria-label={`Paket ${offer.title} buchen`}
          >
            <span class="desktop-arrow">→</span>
            <span class="mobile-booking">Buchen</span>
          </a>
        </article>
      ))}
    </div>

    <button class="offers-next" type="button" aria-label="Weitere Angebote">
      →
    </button>
  </div>

  <a
    href="https://alexandrithaus.sviigo.site"
    target="_blank"
    rel="noopener noreferrer"
    class="offers-all"
  >
    ALLE PAKETE ANSEHEN <span aria-hidden="true">→</span>
  </a>
</section>
<style>
  .combination-offers {
    width: 100%;
    max-width: 1440px;
    height: 450px;
    padding: 40px 60px;
    margin: 0 auto;
    box-sizing: border-box;

    background-color: #dedede;

    display: grid;
    grid-template-columns: 35% 65%;
    align-items: center;
    gap: 30px;
  }

  /* LEFT SIDE */

  .offers-intro {
    max-width: 380px;
  }

  .offers-intro h2 {
    margin: 0 0 20px;
    font-size: 28px;
    font-weight: 500;
    color: #292929;
  }

  .offers-intro p {
    max-width: 320px;
    margin: 0 0 24px;
    font-size: 14px;
    line-height: 1.5;
    color: #555;
  }

  .offers-button {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 30px;
    background-color: #292929;
    color: white;
    font-size: 13px;
    text-decoration: none;
  }

  /* RIGHT SIDE */

  .offers-content {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }

  .offers-list {
    display: flex;
    gap: 24px;
    flex: 0 1 586px;
    min-width: 0;

    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .offers-list::-webkit-scrollbar {
    display: none;
  }

  /* OFFER CARD */

  .offer-card {
    position: relative;
    flex: 0 0 281px;
    width: 281px;
    height: 287px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;

    background-color: #c4c4c4;
    border-radius: 12px;
    overflow: hidden;

    scroll-snap-align: start;
  }

  .offer-image {
    height: 155px;
    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: #aaa;
    color: #555;
    font-size: 14px;
  }

  .offer-info {
    flex: 1;
    padding: 18px;

    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .offer-info h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    color: #292929;
  }

  .offer-info p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #555;
  }

  .offer-price {
    font-size: 14px;
    font-weight: 600;
    color: #292929;
  }

  /* CARD ARROW */

  .offer-arrow {
    position: absolute;
    right: 12px;
    bottom: 12px;

    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background-color: #999;
    color: white;
    font-size: 20px;
    text-decoration: none;
  }

  /* NEXT ARROW */

  .offers-next {
    flex-shrink: 0;
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;
    background-color: #888;
    color: white;
    font-size: 24px;
    cursor: pointer;
  }

  /* HIDDEN ON DESKTOP */

  .offers-all,
  .mobile-booking {
    display: none;
  }

  /* MOBILE VERSION */

  @media (max-width: 600px) {
    .combination-offers {
      width: 100%;
      height: auto;
      max-width: 100%;

      padding: 20px 16px;
      margin: 0;

      display: flex;
      flex-direction: column;
      gap: 14px;

      background: #f6e7e9;
    }

    /* HEADER */

    .offers-intro {
      width: 100%;
      max-width: 100%;
    }

    .offers-intro h2 {
      max-width: 250px;
      margin: 0 0 10px;

      font-size: 23px;
      font-weight: 500;
      line-height: 1.15;
    }

    .offers-intro p,
    .offers-button {
      display: none;
    }

    /* CARDS */

    .offers-content {
      display: block;
      width: 100%;
    }

    .offers-list {
      display: flex;
      flex-direction: column;
      gap: 8px;

      width: 100%;
      overflow: visible;
    }

    .offer-card {
      position: relative;

      display: grid;
      grid-template-columns: 58px minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;

      width: 100%;
      height: 84px;
      min-height: 84px;
      flex: none;

      padding: 9px;
      box-sizing: border-box;

      border-radius: 10px;
      background: #d8c1c4;
    }

    .offer-image {
      width: 58px;
      height: 58px;

      border-radius: 7px;
      background: #bca9ad;
    }

    .offer-info {
      min-width: 0;
      padding: 0;
      gap: 3px;
    }

    .offer-info h3 {
      margin: 0;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.3;
    }

    .offer-info p {
      display: none;
    }

    .offer-price {
      font-size: 12px;
      font-weight: 500;
    }

    /* BOOKING BUTTON */

    .offer-arrow {
      position: static;

      width: auto;
      height: 30px;
      padding: 0 10px;

      border-radius: 20px;
      background: #f7eeee;
      color: #292929;

      font-size: 11px;
      white-space: nowrap;
    }

    .desktop-arrow {
      display: none;
    }

    .mobile-booking {
      display: inline;
    }

    /* HIDE DESKTOP NEXT BUTTON */

    .offers-next {
      display: none;
    }

    /* ALL PACKAGES */

    .offers-all {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;

      width: 100%;
      padding: 12px 0 2px;

      color: #292929;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.4px;
      text-decoration: none;
    }

    .offers-all span {
      font-size: 20px;
    }
  }
</style>
