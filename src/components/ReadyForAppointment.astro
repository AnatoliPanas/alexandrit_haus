---
const bookingUrl = "https://alexandrithaus.sviigo.site";

const socials = [
  {
    name: "Instagram",
    url: "",
    icon: "instagram",
  },
  {
    name: "WhatsApp",
    url: "",
    icon: "whatsapp",
  },
  {
    name: "TikTok",
    url: "",
    icon: "tiktok",
  },
];
---

<section class="ready-section">
  <div class="ready-inner">
    <h2>Bereit für Ihren Termin?</h2>

    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="ready-button"
    >
      Jetzt Termin buchen
    </a>

    <div class="social-links">
      {socials.map((social) =>
        social.url ? (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="social-link"
          >
            {social.icon === "instagram" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            )}

            {social.icon === "whatsapp" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M9 8.5c.5 3 2.5 5 5.5 6l1.5-1.5 2 1c-.5 2-2 3-4 2-3-1-6-4-7-7-.5-2 .5-3.5 2-4l1 2-1 1.5Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"
                />
              </svg>
            )}

            {social.icon === "tiktok" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M14 3v11a4 4 0 1 1-4-4m4-7c.5 3 2.5 5 6 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </a>
        ) : (
          <span
            class="social-link social-disabled"
            title={`${social.name} – Link folgt`}
            aria-label={`${social.name} – Link folgt`}
          >
            {social.icon === "instagram" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
            )}

            {social.icon === "whatsapp" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M9 8.5c.5 3 2.5 5 5.5 6l1.5-1.5 2 1c-.5 2-2 3-4 2-3-1-6-4-7-7-.5-2 .5-3.5 2-4l1 2-1 1.5Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                />
              </svg>
            )}

            {social.icon === "tiktok" && (
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M14 3v11a4 4 0 1 1-4-4m4-7c.5 3 2.5 5 6 5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </span>
        ),
      )}
    </div>
  </div>
</section>

<style>
  .ready-section {
    width: 100%;
    padding: 25px 60px;
    box-sizing: border-box;
    background: #fff;
  }

  .ready-inner {
    max-width: 1320px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .ready-inner h2 {
    margin: 0;
    color: #292929;
    font-size: 24px;
    font-weight: 500;
  }

  .ready-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 190px;
    padding: 12px 24px;

    background: #b9a5aa;
    color: #292929;
    border-radius: 30px;

    font-size: 12px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .ready-button:hover {
    background: #a88e95;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-link {
    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #292929;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  a.social-link:hover {
    color: #a87889;
    transform: translateY(-2px);
  }

  .social-disabled {
    opacity: 0.5;
  }

  .social-link svg {
    width: 22px;
    height: 22px;
  }

  /* TABLET */

  @media (max-width: 900px) {
    .ready-section {
      padding: 30px;
    }

    .ready-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 25px;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .ready-section {
      padding: 30px 16px;
    }

    .ready-inner {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .ready-inner h2 {
      font-size: 22px;
    }

    .ready-button {
      width: 100%;
      max-width: 280px;
      box-sizing: border-box;
    }
  }
</style>
